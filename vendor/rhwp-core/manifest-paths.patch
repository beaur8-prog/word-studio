+    /// Resolve a manifest path relative to the OPF's directory. Hancom also
+    /// writes archive-root paths (Contents/section0.xml, BinData/image1.png),
+    /// so retain those when the OPF-relative entry does not exist. Prefer the
+    /// OPF-relative entry if both exist; never select a root-level decoy first.
+    /// Resolution only inspects the ZIP index and does not decompress entries.
+    pub(super) fn resolve_manifest_path(
+        &mut self,
+        manifest: &str,
+        href: &str,
+    ) -> Result<String, HwpxError> {
+        fn normalize(path: &str) -> Option<String> {
+            if path.starts_with('/') || path.contains(['\\', ':', '\0']) {
+                return None;
+            }
+            let mut parts = Vec::new();
+            for part in path.split('/') {
+                match part {
+                    "" | "." => {}
+                    ".." => {
+                        parts.pop()?;
+                    }
+                    _ => parts.push(part),
+                }
+            }
+            (!parts.is_empty()).then(|| parts.join("/"))
+        }
+
+        let base = manifest.rsplit_once('/').map_or("", |(parent, _)| parent);
+        let path = if base.is_empty() {
+            href.to_string()
+        } else {
+            format!("{base}/{href}")
+        };
+        let relative = normalize(&path)
+            .filter(|_| !href.starts_with('/'))
+            .ok_or_else(|| {
+                HwpxError::XmlError(format!("{manifest}: invalid package path: {href}"))
+            })?;
+        if self.archive.by_name(&relative).is_ok() {
+            return Ok(relative);
+        }
+        if let Some(root) = normalize(href) {
+            if self.archive.by_name(&root).is_ok() {
+                return Ok(root);
+            }
+        }
+        // Keep the resolved path in the subsequent missing-file diagnostic.
+        Ok(relative)
+    }
+
