+    /// Paper-relative pictures keep their page frame even when their anchor
+    /// lives in a table cell. Cell-local placement and clipping heuristics must
+    /// not add the cell origin to an absolute paper coordinate.
+    pub(crate) fn cell_picture_paper_position(
+        &self, tree: &PageLayoutContext, picture: &crate::model::image::Picture,
+        x: f64, y: f64, width: f64, height: f64,
+    ) -> (f64, f64) {
+        use crate::model::shape::HorzRelTo;
+        let common = &picture.common;
+        if common.treat_as_char ||
+            (common.horz_rel_to != HorzRelTo::Paper && common.vert_rel_to != VertRelTo::Paper) {
+            return (x, y);
+        }
+        let (paper_width, paper_height) = tree.page_size();
+        let paper = LayoutRect { x: 0.0, y: 0.0, width: paper_width, height: paper_height };
+        let left = hwpunit_to_px(i32::from(common.margin.left), self.dpi);
+        let right = hwpunit_to_px(i32::from(common.margin.right), self.dpi);
+        let top = hwpunit_to_px(i32::from(common.margin.top), self.dpi);
+        let bottom = hwpunit_to_px(i32::from(common.margin.bottom), self.dpi);
+        let (px, py) = self.compute_object_position(common, width + left + right, height + top + bottom,
+            &paper, &paper, &paper, &paper, 0.0, Alignment::Left);
+        (if common.horz_rel_to == HorzRelTo::Paper { px + left } else { x },
+         if common.vert_rel_to == VertRelTo::Paper { py + top } else { y })
+    }
+
