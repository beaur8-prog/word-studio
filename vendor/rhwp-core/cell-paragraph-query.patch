+    /// Read-only paragraph formatting at any table nesting depth.
+    pub fn get_cell_para_properties_at_by_path_native(
+        &self,
+        sec_idx: usize,
+        parent_para_idx: usize,
+        path: &[(usize, usize, usize)],
+    ) -> Result<String, HwpError> {
+        let para = self.resolve_paragraph_by_path(sec_idx, parent_para_idx, path)?;
+        Ok(self.build_para_properties_json(para.para_shape_id, sec_idx))
+    }
+
+    /// Stored line boxes are diagnostic/import metrics, not fixed text breaks.
+    /// Empty paths address a body paragraph; cell paths address any nesting.
+    pub fn get_paragraph_line_metrics_native(
+        &self,
+        sec_idx: usize,
+        parent_para_idx: usize,
+        path: &[(usize, usize, usize)],
+    ) -> Result<String, HwpError> {
+        let para = if path.is_empty() {
+            self.document.sections.get(sec_idx)
+                .and_then(|section| section.paragraphs.get(parent_para_idx))
+                .ok_or_else(|| HwpError::RenderError("문단을 찾을 수 없음".to_string()))?
+        } else {
+            self.resolve_paragraph_by_path(sec_idx, parent_para_idx, path)?
+        };
+        let px = |value| crate::renderer::hwpunit_to_px(value, self.dpi);
+        let lines: Vec<_> = para.line_segs.iter().map(|line| serde_json::json!({
+            "textStart": line.text_start,
+            "height": px(line.line_height),
+            "textHeight": px(line.text_height),
+            "baseline": px(line.baseline_distance),
+            "spacing": px(line.line_spacing),
+            "verticalPosition": px(line.vertical_pos),
+            "width": px(line.segment_width),
+            "flags": line.tag,
+        })).collect();
+        let tables: Vec<_> = para.controls.iter().enumerate().filter_map(|(index, control)| {
+            if let crate::model::control::Control::Table(table) = control {
+                Some(serde_json::json!({
+                    "index": index,
+                    "inline": table.common.treat_as_char,
+                    "outerTop": px(i32::from(table.common.margin.top)),
+                    "outerBottom": px(i32::from(table.common.margin.bottom)),
+                }))
+            } else { None }
+        }).collect();
+        Ok(serde_json::json!({
+            "stored": !crate::renderer::para_has_no_stored_line_segs(para),
+            "lines": lines,
+            "controlCount": para.controls.len(),
+            "tables": tables,
+        }).to_string())
+    }
