+/// Presence is separate from value: padding:0 must survive a native save.
+fn padding_presence(css: &str) -> [bool; 4] {
+    let shorthand = parse_css_value(css, "padding").is_some();
+    ["left", "right", "top", "bottom"].map(|side|
+        shorthand || parse_css_value(css, &format!("padding-{}", side)).is_some())
