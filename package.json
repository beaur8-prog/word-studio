{
  "name": "word-studio",
  "version": "1.2.11",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Independent local document editor for the Studio office suite",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5191",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/launch.cjs",
    "package:win": "npm run package:win:dir && npm run package:win:setup",
    "package:win:dir": "npm run build && node scripts/package-win.cjs",
    "package:win:setup": "electron-builder --config electron-builder.config.cjs --prepackaged \"release/windows/Word Studio\" --win nsis --x64 --publish never",
    "package:mac": "npm run build && node scripts/package-mac.cjs",
    "package:linux": "npm run build && node scripts/package-linux.cjs",
    "test": "playwright test",
    "test:native": "node --test tests/*.test.cjs",
    "test:desktop": "node scripts/desktop-smoke.cjs",
    "test:linux-package": "node scripts/test-linux-package.cjs"
  },
  "dependencies": {
    "@tiptap/extension-highlight": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extension-subscript": "3.32.0",
    "@tiptap/extension-superscript": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/extension-text-style": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "docx": "9.12.0",
    "dompurify": "^3.2.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "mammoth": "1.13.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@tiptap/extension-underline": "3.32.0",
    "@tiptap/extension-strike": "3.32.0"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@electron/get": "^5.1.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "42.11.15",
    "electron-builder": "26.15.3",
    "resedit": "^1.7.2",
    "sharp": "^0.35.5",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
